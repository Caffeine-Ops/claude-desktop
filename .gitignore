node_modules
out
out-electron
dist
build/
# Exception for ONE file inside apps/studio/build/. `build/` above excludes the
# dir, and git won't descend into an excluded dir — so we must first re-include
# the dir itself (without un-ignoring its other contents), then the file:
#   1. !apps/studio/build/  → allow git to descend into just this build dir
#   2. apps/studio/build/*  → re-ignore everything in it (icons are CI-generated)
#   3. !…/entitlements.mac.plist → the one hand-authored, no-generator file we
#      keep: electron-builder reads it for Developer ID signing on tag builds,
#      so it must ride into the repo or `build:mac` in CI can't find it. Holds
#      only hardened-runtime entitlement keys, no credentials.
!apps/studio/build/
apps/studio/build/*
!apps/studio/build/entitlements.mac.plist
*.log
.DS_Store

# CLI 二进制（~233MB/平台）：**不再随包发布**（2026-07-29 起改为客户端首启按需
# 下载，见 docs/runtime-components-deploy.md）。这个目录现在只是本地开发/发布时
# 放副本的暂存处，不是源码，不入库。版本钉的事实源是服务器上的 components.json。
apps/studio/fusion-bin/

# (移除 2026-07-15) 自带 Node runtime：daemon 已改用 node:sqlite（无 native 依赖），
# 直接跑 Electron 自带 node，不再打包独立 Node runtime。

# Python 3.12 runtime（~72MB/平台解压后）：同上，**不再随包发布**，改为按需下载后
# 落在 userData 下。这个目录只在本地 dev 场景里可能被填（cliDetect 仍留着这条
# dev 候选），不是源码，不入库。
apps/studio/python-runtime/

# skill 的运行时产物（本机跑 skill 时生成，非源码）：
# ppt-master/projects/ 是生成的 PPT 工程；__pycache__/ 是 Python 字节码缓存
# （gpt-image-2 移植成 Python 后也会产生，统一按所有 skill 忽略）。
# skills-src/ 是 ppt-creator 改按需下载后的源码位置（原 skills/ppt-master/ 已
# 迁走，见 publish-ppt-skill.ts 头注释）——两条规则都留着，覆盖新旧两个位置。
skills/ppt-master/projects/
skills/**/__pycache__/
skills-src/**/__pycache__/

# prebundle 打包产物 (~160M)：scripts/prebundle-daemon.mjs 生成（每次先 rm 重建），
# 内容全是从 repo 别处复制来的（daemon bundle + apps/web/out + skills/
# design-systems/… 等根目录资源），无唯一副本。electron-builder 打包时用，
# 重新生成用 `bun run prebundle:daemon`。不入库。
apps/studio/prebundled/

# 图片量化缓存：prebundle-daemon.mjs 每次 rm 重建 prebundled/，压缩结果按
# 源文件的 路径+mtime+size 缓存在这里，避免每次打包重压 124 张图。可随时删。
apps/studio/.image-cache/

.env
.env.local
# Exception: gpt-image-2 ships a secret-free `.env` carrying ONLY the
# ENABLE_GARDEN_IMAGEGEN switch (the API key stays in env.json/host env). It
# must be tracked so it rides along into the packaged app — otherwise Mode A
# never turns on for end users. Safe because it holds no credentials.
!skills/gpt-image-2/.env
# Exception: same pattern for ppt-master — a secret-free `.env` carrying ONLY
# IMAGE_BACKEND/OPENAI_MODEL switches so AI image gen works out of the box on a
# fresh install. Credentials come from env.json/host env. Must be tracked to
# ride into the package.
!skills/ppt-master/.env
.vite
env.json
.gstack/
*.tsbuildinfo
.claude/settings.local.json

# open-design 运行时产物 (daemon/web 生成, 不入库)
.od
.od-e2e
.next
.next-*/

# Next 自动生成/覆写的环境声明（文件自带注释「should not be edited」）。内容
# 随最后一次跑的是 `next dev` 还是 `next build` 在两个 routes.d.ts 路径间来回
# 切换（Next 16 引入的 dev/build 分离），本地 dev/build 循环下必然产生纯噪音
# diff。CI 的 typecheck 跑在任何 next 命令之前、`.next/` 尚不存在时也一样过
# （已实测：临时移走 `.next/` 后 `tsc --noEmit` 仍零报错），说明它已提交的具体
# 内容从未被真正依赖过。忽略后本地任何一次 dev/build 都会自动重新生成，无需
# 手动维护。
apps/studio/next-env.d.ts

.tmp/
apps/web/out
e2e/.od-data

# 设计原型稿 (一次性方向稿, 不入库)
prototypes/
.design-proto/

# 一次性分析脚本 (与本项目无关：读别的项目数据生成 Excel，输出路径写死本机桌面)
scripts/export_his_analysis.py

